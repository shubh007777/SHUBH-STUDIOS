# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# Email address allowed to log into the Admin Dashboard (/admin).
ADMIN_EMAIL=kumarshubh8750@gmail.com

# Password for the admin account.
ADMIN_PASSWORD=Shubh@7053

# Secret key used to sign and verify JSON Web Tokens (JWT) for admin sessions.
# Generate a random 32+ character string in production.
JWT_SECRET=shubh_travel_video_editor_portfolio_production_jwt_secret_2026

# ------------------------------------------------------------------------------
# 2. PERSISTENT PRODUCTION DATABASE (REQUIRED FOR PERSISTENCE)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection string.
# Supports: Neon (neon.tech), Supabase (supabase.com), Vercel Postgres,
# Railway (railway.app), Render (render.com), or AWS RDS.
#
# Tables and initial data (videos, photos, site content) are automatically
# created and seeded on the first request.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]?sslmode=require

# ------------------------------------------------------------------------------
# 3. PERSISTENT FILE STORAGE FOR MEDIA UPLOADS (CHOOSE ONE)
# ------------------------------------------------------------------------------
# OPTION A: Cloudinary (Recommended - Free 25GB, works on all platforms)
# Get from Cloudinary Dashboard (https://cloudinary.com):
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# OPTION B: Vercel Blob (If hosting on Vercel)
# Created under Vercel Project Dashboard -> Storage -> Blob:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# NOTE: If neither Cloudinary nor Vercel Blob token is set, but DATABASE_URL is set,
# uploaded media files are permanently stored directly in your PostgreSQL database!
